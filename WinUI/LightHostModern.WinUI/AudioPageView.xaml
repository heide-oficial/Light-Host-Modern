<?xml version='1.0' encoding='utf-8'?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="LightHostModernWinUI.AudioPageView" xmlns:local="using:LightHostModernWinUI">
    <StackPanel x:Name="PreferencesPanel" Visibility="Collapsed" Spacing="18">
        <InfoBar x:Name="AudioUnavailableNotice" IsOpen="False" IsClosable="False" Severity="Warning" />
        <Border x:Name="DeviceRoutingCard" Style="{StaticResource AppCardStyle}">
            <StackPanel Spacing="14">
                <TextBlock x:Name="DevicesTitle" Style="{StaticResource SubtitleTextBlockStyle}" Text="Devices" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="BackendLabel" Text="Audio backend" VerticalAlignment="Center" />
                    <StackPanel x:Name="AudioBackendBoxHost" Grid.Column="1" />
                </Grid>
                <Grid x:Name="InputDeviceRow">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="InputDeviceLabel" Text="Input device" VerticalAlignment="Center" />
                    <StackPanel x:Name="InputBoxHost" Grid.Column="1" />
                </Grid>
                <Grid x:Name="OutputDeviceRow">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="OutputDeviceLabel" Text="Output device" VerticalAlignment="Center" />
                    <StackPanel x:Name="OutputBoxHost" Grid.Column="1" />
                </Grid>
            </StackPanel>
        </Border>
        <Border x:Name="FormatCard" Style="{StaticResource AppCardStyle}">
            <StackPanel Spacing="14">
                <TextBlock x:Name="FormatTitle" Style="{StaticResource SubtitleTextBlockStyle}" Text="Format" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SampleRateLabel" Text="Sample rate" VerticalAlignment="Center" />
                    <StackPanel x:Name="SampleRateBoxHost" Grid.Column="1" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="BufferSizeLabel" Text="Buffer size" VerticalAlignment="Center" />
                    <StackPanel x:Name="BufferSizeBoxHost" Grid.Column="1" />
                </Grid>
            </StackPanel>
        </Border>
        <Grid x:Name="ChannelsCard" ColumnSpacing="16" RowSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border x:Name="InputSettingsCard" Grid.Column="0" Grid.Row="0" AutomationProperties.AutomationId="InputSettingsCard" Visibility="{Binding Visibility, ElementName=InputChannelGroup}" Style="{StaticResource AppCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="InputSettingsTitle" Text="Input settings" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="InputMonoLabel" Text="Input mode" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <ComboBox x:Name="InputModeBox" Grid.Column="1" AutomationProperties.AutomationId="InputModeBox" MinWidth="160" MinHeight="36" Padding="12,5,32,5" VerticalContentAlignment="Center" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ComboBoxItem Content="Stereo" /><ComboBoxItem Content="Mono" />
                        </ComboBox>
                    </Grid>
                    <Grid ColumnSpacing="16" Visibility="{Binding Visibility, ElementName=InputGroupingBox}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="InputSelectionLabel" Text="Channel selection" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <ComboBox x:Name="InputGroupingBox" Grid.Column="1" AutomationProperties.AutomationId="InputChannelGrouping" MinWidth="160" MinHeight="36" Padding="12,5,32,5" VerticalContentAlignment="Center" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ComboBoxItem Content="Pairs" /><ComboBoxItem Content="Individual" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>
            <Border x:Name="OutputSettingsCard" Grid.Column="1" Grid.Row="0" AutomationProperties.AutomationId="OutputSettingsCard" Visibility="{Binding Visibility, ElementName=OutputChannelGroup}" Style="{StaticResource AppCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="OutputSettingsTitle" Text="Output settings" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="OutputMonoLabel" Text="Output mode" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <ComboBox x:Name="OutputModeBox" Grid.Column="1" AutomationProperties.AutomationId="OutputModeBox" MinWidth="160" MinHeight="36" Padding="12,5,32,5" VerticalContentAlignment="Center" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ComboBoxItem Content="Stereo" /><ComboBoxItem Content="Mono" />
                        </ComboBox>
                    </Grid>
                    <Grid ColumnSpacing="16" Visibility="{Binding Visibility, ElementName=OutputGroupingBox}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="OutputSelectionLabel" Text="Channel selection" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <ComboBox x:Name="OutputGroupingBox" Grid.Column="1" AutomationProperties.AutomationId="OutputChannelGrouping" MinWidth="160" MinHeight="36" Padding="12,5,32,5" VerticalContentAlignment="Center" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <ComboBoxItem Content="Pairs" /><ComboBoxItem Content="Individual" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>
            <Border x:Name="InputChannelGroup" Grid.Column="0" Grid.Row="1" AutomationProperties.AutomationId="InputChannelsCard" Style="{StaticResource AppCardStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="InputChannelsTitle" Text="Input channels" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button x:Name="InputChannelsToggleAllButton" Grid.Column="1" Content="Uncheck all" Height="32" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel x:Name="InputChannelsPanel" />
                </StackPanel>
            </Border>
            <Border x:Name="OutputChannelGroup" Grid.Column="1" Grid.Row="1" AutomationProperties.AutomationId="OutputChannelsCard" Style="{StaticResource AppCardStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="OutputChannelsTitle" Text="Output channels" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button x:Name="OutputChannelsToggleAllButton" Grid.Column="1" Content="Uncheck all" Height="32" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel x:Name="OutputChannelsPanel" />
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
