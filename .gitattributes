* text=auto

*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.idl text eol=lf
*.xaml text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf

*.png binary
*.mp4 binary
*.ico binary
*.exe binary
*.dll binary
*.pdb binary

# Preserve upstream license bytes and their recorded hashes.
ThirdParty/Licenses/** -text -whitespace
